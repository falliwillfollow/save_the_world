{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/gate_report.schema.json",
  "title": "GateReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "compiled_plan", "promotion_allowed", "results"],
  "properties": {
    "kind": { "const": "GateReport" },
    "compiled_plan": { "type": "string" },
    "promotion_allowed": { "type": "boolean" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "status", "survival_critical", "evidence", "remediation"],
        "properties": {
          "gate": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
          "survival_critical": { "type": "boolean" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "remediation": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

