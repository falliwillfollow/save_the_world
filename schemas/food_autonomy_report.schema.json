{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/food_autonomy_report.schema.json",
  "title": "FoodAutonomyReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "generated_by",
    "provisional",
    "status",
    "source_cycle_iteration",
    "population",
    "food_autonomy",
    "seasonal_smoothing",
    "risk_scenario_coverage",
    "hotspots",
    "recommendations",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "FoodAutonomyReport" },
    "id": { "type": "string" },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "source_cycle_iteration": { "type": "string" },
    "population": { "type": "integer", "minimum": 0 },
    "food_autonomy": { "type": "object" },
    "seasonal_smoothing": { "type": "object" },
    "risk_scenario_coverage": { "type": "object" },
    "hotspots": { "type": "array", "items": { "type": "object" } },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
