{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/scalability_gate_report.schema.json",
  "title": "ScalabilityGateReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "generated_by",
    "provisional",
    "status",
    "compiled_plan",
    "technology_module",
    "passes_scalability_gate",
    "gate_results",
    "scaling_targets",
    "module_summary",
    "next_actions",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "ScalabilityGateReport" },
    "id": { "type": "string" },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "compiled_plan": { "type": "string" },
    "technology_module": { "type": "string" },
    "passes_scalability_gate": { "type": "boolean" },
    "gate_results": { "type": "array", "items": { "type": "object" } },
    "scaling_targets": { "type": "array", "items": { "type": "object" } },
    "module_summary": { "type": "object" },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
