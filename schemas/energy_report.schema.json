{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/energy_report.schema.json",
  "title": "EnergyReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "compiled_plan",
    "energy_plan",
    "generated_by",
    "days",
    "provisional",
    "status",
    "normal_balance",
    "critical_load_autonomy",
    "outage_survival",
    "load_shedding_plan",
    "solar_reduction",
    "refrigeration_risk",
    "backup_energy_gap",
    "maintenance",
    "energy_safety_warnings",
    "redesign_recommendations",
    "bottlenecks",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "EnergyReport" },
    "id": { "type": "string" },
    "compiled_plan": { "type": "string" },
    "energy_plan": { "type": "string" },
    "generated_by": { "type": "string" },
    "days": { "type": "integer", "minimum": 1 },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "normal_balance": { "type": "object" },
    "critical_load_autonomy": { "type": "object" },
    "outage_survival": { "type": "object" },
    "load_shedding_plan": { "type": "array", "items": { "type": "object" } },
    "solar_reduction": { "type": "object" },
    "refrigeration_risk": { "type": "object" },
    "backup_energy_gap": { "type": "object" },
    "maintenance": { "type": "object" },
    "energy_safety_warnings": { "type": "array", "items": { "type": "string" } },
    "redesign_recommendations": { "type": "array", "items": { "type": "string" } },
    "bottlenecks": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
