{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/patch_materialization_report.schema.json",
  "title": "PatchMaterializationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "id",
    "status",
    "source_patch_proposal_id",
    "source_candidate_id",
    "source_candidate_title",
    "focus_domain",
    "materialized_kind",
    "materialized_artifact_path",
    "placement_target",
    "validation",
    "suggested_plan_change",
    "next_actions",
    "provisional"
  ],
  "properties": {
    "kind": { "const": "PatchMaterializationReport" },
    "version": { "const": "v0" },
    "id": { "type": "string", "minLength": 3 },
    "status": { "type": "string", "enum": ["materialized_draft", "blocked"] },
    "source_patch_proposal_id": { "type": "string", "minLength": 3 },
    "source_candidate_id": { "type": "string", "minLength": 3 },
    "source_candidate_title": { "type": "string", "minLength": 3 },
    "focus_domain": { "type": "string", "minLength": 2 },
    "materialized_kind": { "type": "string", "enum": ["CivicPattern"] },
    "materialized_artifact_path": { "type": "string", "minLength": 3 },
    "placement_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "label", "relationship"],
      "properties": {
        "object_id": { "type": "string" },
        "label": { "type": "string" },
        "relationship": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_valid", "blocking_reasons", "warnings"],
      "properties": {
        "artifact_valid": { "type": "boolean" },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "suggested_plan_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_pattern_id", "resolved_external_dependencies", "notes"],
      "properties": {
        "selected_pattern_id": { "type": "string", "minLength": 3 },
        "resolved_external_dependencies": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "next_actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "provisional": { "type": "boolean" }
  }
}
