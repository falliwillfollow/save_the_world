{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/automation_manifest.schema.json",
  "title": "AutomationManifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kind",
    "version",
    "manifest_id",
    "source",
    "automation_thesis",
    "allowed_automation_domains",
    "blocked_automation_domains",
    "tasks",
    "human_sovereignty_boundaries",
    "review_gates",
    "warnings"
  ],
  "properties": {
    "kind": { "const": "AutomationManifest" },
    "version": { "const": "v0" },
    "manifest_id": { "type": "string", "minLength": 3 },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["runtime_bundle_path", "world_manifest_path", "generated_at", "provisional"],
      "properties": {
        "runtime_bundle_path": { "type": ["string", "null"] },
        "world_manifest_path": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"] },
        "provisional": { "type": "boolean" }
      }
    },
    "automation_thesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagline", "description"],
      "properties": {
        "tagline": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "allowed_automation_domains": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "blocked_automation_domains": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/task" } },
    "human_sovereignty_boundaries": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "review_gates": { "type": "array", "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "type": "object" } }
  },
  "definitions": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "actor",
        "trigger",
        "input_data",
        "output",
        "human_review_required",
        "review_gate",
        "privacy_level",
        "failure_mode",
        "visible_in_world"
      ],
      "properties": {
        "id": { "type": "string" },
        "domain": { "type": "string" },
        "actor": { "type": "string", "enum": ["AI_scheduler", "AI_simulation_runner", "AI_narrative_compiler", "human", "robot_assisted", "human_reviewed_AI"] },
        "trigger": { "type": "string" },
        "input_data": { "type": "array", "items": { "type": "string" } },
        "output": { "type": "string" },
        "human_review_required": { "type": "boolean" },
        "review_gate": { "type": ["string", "null"] },
        "privacy_level": { "type": "string", "enum": ["public", "member_visible", "role_limited", "private", "anonymized_or_role_limited", "public_archetype_only"] },
        "failure_mode": { "type": "string" },
        "visible_in_world": { "type": "boolean" }
      }
    }
  }
}
