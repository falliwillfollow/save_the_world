{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/candidate_plan_matrix_report.schema.json",
  "title": "CandidatePlanMatrixReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "compiled_plan",
    "optimization_profile",
    "generated_by",
    "provisional",
    "status",
    "candidate_count",
    "viable_candidate_count",
    "scenario_count",
    "baseline_days",
    "candidates",
    "rankings",
    "metric_updates",
    "next_actions",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "CandidatePlanMatrixReport" },
    "id": { "type": "string" },
    "compiled_plan": { "type": "string" },
    "optimization_profile": { "type": "string" },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["not_ready", "ready_with_warnings", "ready"] },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "viable_candidate_count": { "type": "integer", "minimum": 0 },
    "scenario_count": { "type": "integer", "minimum": 0 },
    "baseline_days": { "type": "integer", "minimum": 1 },
    "candidates": { "type": "array", "items": { "type": "object" } },
    "rankings": { "type": "array", "items": { "type": "object" } },
    "metric_updates": { "type": "object" },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
