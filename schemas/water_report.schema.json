{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/water_report.schema.json",
  "title": "WaterReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "compiled_plan",
    "water_plan",
    "generated_by",
    "days",
    "population",
    "provisional",
    "status",
    "storage",
    "normal_balance",
    "drought_balance",
    "contamination_response",
    "testing",
    "demand_reduction_needed",
    "water_safety_warnings",
    "redesign_recommendations",
    "bottlenecks",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "WaterReport" },
    "id": { "type": "string" },
    "compiled_plan": { "type": "string" },
    "water_plan": { "type": "string" },
    "generated_by": { "type": "string" },
    "days": { "type": "integer", "minimum": 1 },
    "population": { "type": "integer", "minimum": 1 },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "storage": { "type": "object" },
    "normal_balance": { "type": "object" },
    "drought_balance": { "type": "object" },
    "contamination_response": { "type": "object" },
    "testing": { "type": "object" },
    "demand_reduction_needed": { "type": "object" },
    "water_safety_warnings": { "type": "array", "items": { "type": "string" } },
    "redesign_recommendations": { "type": "array", "items": { "type": "string" } },
    "bottlenecks": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
