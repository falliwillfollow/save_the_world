{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/role_plan.schema.json",
  "title": "RolePlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "name",
    "description",
    "weeks",
    "provisional",
    "rotation_cadence_weeks",
    "max_compulsory_hours_per_person_per_week",
    "care_work_allowance_hours_per_week",
    "backup_required",
    "participants",
    "role_requirements",
    "notes"
  ],
  "properties": {
    "kind": { "const": "RolePlan" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 10 },
    "weeks": { "type": "integer", "minimum": 1 },
    "provisional": { "type": "boolean" },
    "rotation_cadence_weeks": { "type": "integer", "minimum": 1 },
    "max_compulsory_hours_per_person_per_week": { "type": "number", "minimum": 0 },
    "care_work_allowance_hours_per_week": { "type": "number", "minimum": 0 },
    "backup_required": { "type": "boolean" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "availability_hours_per_week", "skills", "reduced_load", "protected_notes", "care_hours_per_week", "eligible_roles"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "availability_hours_per_week": { "type": "number", "minimum": 0 },
          "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "reduced_load": { "type": "boolean" },
          "protected_notes": { "type": "string" },
          "care_hours_per_week": { "type": "number", "minimum": 0 },
          "eligible_roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "role_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "required_skills", "safety_critical", "min_people", "training_path"],
        "properties": {
          "role": { "type": "string", "minLength": 3 },
          "required_skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "safety_critical": { "type": "boolean" },
          "min_people": { "type": "integer", "minimum": 1 },
          "training_path": { "type": "string", "minLength": 3 }
        }
      }
    },
    "notes": { "type": "string", "minLength": 5 }
  }
}
