{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/world_manifest.schema.json",
  "title": "CivicFloorWorldManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "world_id",
    "generated_at",
    "source",
    "population",
    "scale",
    "modules",
    "zones",
    "structures",
    "paths",
    "infrastructure_nodes",
    "residents",
    "daily_events",
    "scenario_states",
    "overlays",
    "resource_telemetry",
    "evidence_cards",
    "warnings",
    "failures",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "CivicFloorWorldManifest" },
    "version": { "const": "v0" },
    "world_id": { "type": "string", "minLength": 3 },
    "generated_at": { "type": ["string", "null"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_bundle_path", "simulation_id", "profile_id", "provisional"],
      "properties": {
        "runtime_bundle_path": { "type": ["string", "null"] },
        "simulation_id": { "type": ["string", "null"] },
        "profile_id": { "type": ["string", "null"] },
        "provisional": { "type": "boolean" }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residents", "households", "active_scale_slider_value"],
      "properties": {
        "residents": { "type": "integer", "minimum": 1 },
        "households": { "type": "integer", "minimum": 1 },
        "active_scale_slider_value": { "type": "integer", "minimum": 1 }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_class", "recommended_unit_size", "implied_village_blocks", "scaling_mode", "active_layers"],
      "properties": {
        "scale_class": {
          "type": "string",
          "enum": ["micro_commons", "village_block", "multi_block_district", "town_city_layer", "regional_membrane"]
        },
        "recommended_unit_size": { "type": "integer", "minimum": 1 },
        "implied_village_blocks": { "type": "integer", "minimum": 1 },
        "scaling_mode": {
          "type": "string",
          "enum": ["seed", "minimal", "single_node", "replicated_nodes", "mixed_topology", "federated_layers"]
        },
        "active_layers": { "type": "array", "items": { "type": "string" } },
        "topology_policy_id": { "type": "string" },
        "topology_counts": { "type": "object" }
      }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/definitions/module" }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/zone" }
    },
    "structures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/structure" }
    },
    "paths": {
      "type": "array",
      "items": { "$ref": "#/definitions/path" }
    },
    "infrastructure_nodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/infrastructure_node" }
    },
    "residents": {
      "type": "array",
      "items": { "$ref": "#/definitions/resident" }
    },
    "daily_events": {
      "type": "array",
      "items": { "$ref": "#/definitions/daily_event" }
    },
    "scenario_states": {
      "type": "array",
      "items": { "$ref": "#/definitions/scenario_state" }
    },
    "overlays": { "type": "object" },
    "resource_telemetry": { "$ref": "#/definitions/resource_telemetry" },
    "evidence_cards": {
      "type": "array",
      "items": { "$ref": "#/definitions/evidence_card" }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "failures": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": true,
      "required": ["module_id", "pattern_id", "tier", "status", "review_status", "provisional"],
      "properties": {
        "module_id": { "type": "string" },
        "pattern_id": { "type": "string" },
        "tier": {
          "type": "string",
          "enum": ["floor_systems", "operating_systems", "capacity_systems", "meta_systems"]
        },
        "status": {
          "type": "string",
          "enum": ["spec_only", "contract_defined", "pattern_implemented", "simulation_connected", "viewer_connected", "scenario_tested", "promotion_blocked"]
        },
        "review_status": {
          "type": "string",
          "enum": ["not_reviewed", "review_required", "reviewed", "blocked"]
        },
        "provisional": { "type": "boolean" }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "label", "position", "size", "color_token", "module_refs", "evidence_card_id"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "position": { "$ref": "#/definitions/vector3" },
        "size": { "$ref": "#/definitions/vector3" },
        "color_token": { "type": "string" },
        "module_refs": { "type": "array", "items": { "type": "string" } },
        "evidence_card_id": { "type": "string" }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "label", "position", "rotation", "size", "asset_key", "module_refs", "systems", "state", "evidence_card_id"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "position": { "$ref": "#/definitions/vector3" },
        "rotation": { "$ref": "#/definitions/vector3" },
        "size": { "$ref": "#/definitions/vector3" },
        "asset_key": { "type": "string" },
        "module_refs": { "type": "array", "items": { "type": "string" } },
        "systems": { "type": "array", "items": { "type": "string" } },
        "state": {
          "type": "object",
          "additionalProperties": true,
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["normal", "warning", "degraded", "failed", "unknown"] }
          }
        },
        "evidence_card_id": { "type": "string" }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "label", "points", "accessibility", "module_refs", "evidence_card_id"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/vector3" } },
        "accessibility": { "type": "object" },
        "module_refs": { "type": "array", "items": { "type": "string" } },
        "evidence_card_id": { "type": "string" }
      }
    },
    "infrastructure_node": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "label", "position", "asset_key", "module_refs", "metrics", "evidence_card_id"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "position": { "$ref": "#/definitions/vector3" },
        "asset_key": { "type": "string" },
        "module_refs": { "type": "array", "items": { "type": "string" } },
        "metrics": { "type": "object" },
        "evidence_card_id": { "type": "string" }
      }
    },
    "resident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "archetype", "label", "home_structure_id", "daily_profile_id", "privacy", "position"],
      "properties": {
        "id": { "type": "string" },
        "archetype": { "type": "string" },
        "label": { "type": "string" },
        "home_structure_id": { "type": "string" },
        "daily_profile_id": { "type": "string" },
        "privacy": { "const": "archetype_only" },
        "position": { "$ref": "#/definitions/vector3" }
      }
    },
    "daily_event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "resident_id", "time", "duration_minutes", "type", "label", "location_id", "module_refs", "visual"],
      "properties": {
        "id": { "type": "string" },
        "resident_id": { "type": "string" },
        "time": { "type": "string" },
        "duration_minutes": { "type": "integer", "minimum": 1 },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "location_id": { "type": "string" },
        "module_refs": { "type": "array", "items": { "type": "string" } },
        "visual": { "type": "object" }
      }
    },
    "scenario_state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "type", "timeline", "status"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "timeline": { "type": "array", "items": { "type": "object" } },
        "status": { "type": "string", "enum": ["modeled", "placeholder", "not_available"] }
      }
    },
    "resource_telemetry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["resources", "labor", "provisional"],
      "properties": {
        "resources": {
          "type": "array",
          "items": { "$ref": "#/definitions/resource_metric" }
        },
        "labor": { "type": "object" },
        "provisional": { "type": "boolean" }
      }
    },
    "resource_metric": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "unit", "status", "capacity", "current", "minimum", "reserve_floor", "net_per_day", "drawdown", "current_ratio", "minimum_ratio", "reserve_floor_ratio", "provisional"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "unit": { "type": "string" },
        "status": { "type": "string" },
        "capacity": { "type": "number" },
        "current": { "type": "number" },
        "minimum": { "type": "number" },
        "reserve_floor": { "type": "number" },
        "net_per_day": { "type": "number" },
        "drawdown": { "type": "number" },
        "current_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "reserve_floor_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "provisional": { "type": "boolean" }
      }
    },
    "evidence_card": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "summary", "module_refs", "assumptions", "review_required", "status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "module_refs": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "review_required": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" }
      }
    }
  }
}
