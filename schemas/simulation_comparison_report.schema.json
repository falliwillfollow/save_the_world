{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/simulation_comparison_report.schema.json",
  "title": "SimulationComparisonReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "baseline_simulation",
    "replay_simulation",
    "generated_by",
    "provisional",
    "status",
    "scenario_context",
    "status_delta",
    "duration",
    "resource_deltas",
    "storage_deltas",
    "labor_delta",
    "unmet_need_deltas",
    "failure_day_delta",
    "recovery_delta",
    "review_delta",
    "bottlenecks",
    "summary",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "SimulationComparisonReport" },
    "id": { "type": "string" },
    "baseline_simulation": { "type": "string" },
    "replay_simulation": { "type": "string" },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["stable", "stress_warn", "stress_failed"] },
    "scenario_context": { "type": "object" },
    "status_delta": { "type": "object" },
    "duration": { "type": "object" },
    "resource_deltas": { "type": "array", "items": { "type": "object" } },
    "storage_deltas": { "type": "array", "items": { "type": "object" } },
    "labor_delta": { "type": "object" },
    "unmet_need_deltas": { "type": "array", "items": { "type": "object" } },
    "failure_day_delta": { "type": "object" },
    "recovery_delta": { "type": "object" },
    "review_delta": { "type": "object" },
    "bottlenecks": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
