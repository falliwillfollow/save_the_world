{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/patch_proposal.schema.json",
  "title": "PatchProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "id",
    "source_candidate_id",
    "source_loop_id",
    "focus_domain",
    "title",
    "status",
    "target",
    "model_changes",
    "simulation_checks",
    "acceptance_tests",
    "validation",
    "implementation_notes",
    "provisional"
  ],
  "properties": {
    "kind": { "const": "PatchProposal" },
    "version": { "const": "v0" },
    "id": { "type": "string", "minLength": 3 },
    "source_candidate_id": { "type": "string", "minLength": 3 },
    "source_loop_id": { "type": "string", "minLength": 3 },
    "focus_domain": { "type": "string", "minLength": 2 },
    "title": { "type": "string", "minLength": 3 },
    "status": {
      "type": "string",
      "enum": ["draft", "needs_evidence", "simulation_ready", "simulation_tested", "blocked", "rejected", "promoted"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "change_type"],
      "properties": {
        "artifact": { "type": "string", "minLength": 3 },
        "change_type": {
          "type": "string",
          "enum": [
            "add_pattern",
            "update_pattern",
            "add_module",
            "add_operating_protocol",
            "add_scenario_playbook",
            "add_governance_rule",
            "add_research_task"
          ]
        }
      }
    },
    "model_changes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/model_change" }
    },
    "simulation_checks": { "type": "array", "items": { "type": "string" } },
    "acceptance_tests": { "type": "array", "items": { "type": "string" } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_valid", "blocking_reasons", "warnings"],
      "properties": {
        "schema_valid": { "type": "boolean" },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "implementation_notes": { "type": "array", "items": { "type": "string" } },
    "provisional": { "type": "boolean" }
  },
  "definitions": {
    "model_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "from", "to", "rationale", "provisional"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "from": {},
        "to": {},
        "rationale": { "type": "string", "minLength": 3 },
        "provisional": { "type": "boolean" }
      }
    }
  }
}
