{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/module_compatibility_report.schema.json",
  "title": "ModuleCompatibilityReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "generated_by",
    "provisional",
    "status",
    "compiled_plan",
    "module_registry",
    "slot_results",
    "drag_and_drop_candidates",
    "adapter_required",
    "not_applicable",
    "research_backlog",
    "next_actions",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "ModuleCompatibilityReport" },
    "id": { "type": "string" },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["ready_with_warnings", "needs_research", "not_ready"] },
    "compiled_plan": { "type": "string" },
    "module_registry": { "type": "string" },
    "slot_results": { "type": "array", "items": { "type": "object" } },
    "drag_and_drop_candidates": { "type": "array", "items": { "type": "object" } },
    "adapter_required": { "type": "array", "items": { "type": "object" } },
    "not_applicable": { "type": "array", "items": { "type": "object" } },
    "research_backlog": { "type": "array", "items": { "type": "object" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
