{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/comparison_report.schema.json",
  "title": "ComparisonReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "before_audit",
    "after_audit",
    "generated_by",
    "provisional",
    "status",
    "blocker_count_before",
    "blocker_count_after",
    "blocker_delta",
    "promotion_decision_delta",
    "status_changes_by_subsystem",
    "resolved_blockers",
    "remaining_blockers",
    "new_blockers",
    "new_warnings",
    "metric_deltas",
    "acceptance_criteria",
    "summary",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "ComparisonReport" },
    "id": { "type": "string" },
    "before_audit": { "type": "string" },
    "after_audit": { "type": "string" },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["improved", "unchanged", "regressed"] },
    "blocker_count_before": { "type": "integer", "minimum": 0 },
    "blocker_count_after": { "type": "integer", "minimum": 0 },
    "blocker_delta": { "type": "integer" },
    "promotion_decision_delta": { "type": "object" },
    "status_changes_by_subsystem": { "type": "array", "items": { "type": "object" } },
    "resolved_blockers": { "type": "array", "items": { "type": "string" } },
    "remaining_blockers": { "type": "array", "items": { "type": "string" } },
    "new_blockers": { "type": "array", "items": { "type": "string" } },
    "new_warnings": { "type": "array", "items": { "type": "string" } },
    "metric_deltas": { "type": "object" },
    "acceptance_criteria": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
