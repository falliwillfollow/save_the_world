{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/foundation_gate_report.schema.json",
  "title": "FoundationGateReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "compiled_plan",
    "generated_by",
    "provisional",
    "status",
    "ready_for_visual_buildout",
    "checks",
    "artifact_summary",
    "stop_conditions",
    "next_actions",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "FoundationGateReport" },
    "id": { "type": "string" },
    "compiled_plan": { "type": "string" },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["not_ready", "ready_with_warnings", "ready"] },
    "ready_for_visual_buildout": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence", "remediation", "provisional"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
          "evidence": { "type": "string" },
          "remediation": { "type": "string" },
          "provisional": { "type": "boolean" }
        }
      }
    },
    "artifact_summary": { "type": "object" },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "met", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "met": { "type": "boolean" },
          "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
