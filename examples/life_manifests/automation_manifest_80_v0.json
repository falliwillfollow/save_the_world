  "tasks": [
    {
      "actor": "AI_scheduler",
      "domain": "water",
      "failure_mode": "missed testing interval or stale reserve status",
      "human_review_required": true,
      "id": "water_quality_check_schedule",
      "input_data": [
        "water_public_health_protocol",
        "water_reserve_status",
        "testing_calendar"
      ],
      "output": "water_testing_task",
      "privacy_level": "member_visible",
      "review_gate": "public_health",
      "trigger": "weekly",
      "visible_in_world": true
    },
    {
      "actor": "AI_scheduler",
      "domain": "food",
      "failure_mode": "inventory recommendation hides shortage or dietary risk",
      "human_review_required": true,
      "id": "food_inventory_balance",
      "input_data": [
        "food_inventory",
        "meal_demand_forecast",
        "dietary_constraints_summary"
      ],
      "output": "food_inventory_warning",
      "privacy_level": "role_limited",
      "review_gate": "food_safety",
      "trigger": "daily",
      "visible_in_world": true
    },
    {
      "actor": "human_reviewed_AI",
      "domain": "care_health",
      "failure_mode": "route exposes private health or care information",
      "human_review_required": true,
      "id": "care_meal_route",
      "input_data": [
        "care_meal_requests",
        "accessible_route_status",
        "privacy_limited_delivery_window"
      ],
      "output": "delivery_schedule",
      "privacy_level": "role_limited",
      "review_gate": "privacy",
      "trigger": "care_meal_request",
      "visible_in_world": true
    },
    {
      "actor": "AI_scheduler",
      "domain": "maintenance_repair",
      "failure_mode": "priority queue defers safety-critical repair",
      "human_review_required": true,
      "id": "maintenance_queue_prioritization",
      "input_data": [
        "work_orders",
        "asset_criticality",
        "safety_flags"
      ],
      "output": "prioritized_work_queue",
      "privacy_level": "member_visible",
      "review_gate": "safety",
      "trigger": "work_order_created",
      "visible_in_world": true
    },
    {
      "actor": "human_reviewed_AI",
      "domain": "labor_time",
      "failure_mode": "hidden labor pattern is missed or privacy is overexposed",
