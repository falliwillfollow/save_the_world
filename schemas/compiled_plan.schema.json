{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/compiled_plan.schema.json",
  "title": "CompiledPlan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kind",
    "id",
    "source_site_profile",
    "generated_by",
    "provisional",
    "site_summary",
    "selected_patterns",
    "dependency_order",
    "missing_dependencies",
    "phases",
    "maintenance_calendar",
    "role_burden",
    "layout_graph",
    "risk_register",
    "simulation_inputs",
    "promotion_status"
  ],
  "properties": {
    "kind": { "const": "CompiledPlan" },
    "id": { "type": "string" },
    "source_site_profile": { "type": "string" },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "site_summary": { "type": "object" },
    "selected_patterns": { "type": "array", "items": { "type": "string" } },
    "dependency_order": { "type": "array", "items": { "type": "string" } },
    "missing_dependencies": { "type": "array", "items": { "type": "object" } },
    "phases": { "type": "array", "items": { "type": "object" } },
    "maintenance_calendar": { "type": "array", "items": { "type": "object" } },
    "role_burden": { "type": "object" },
    "layout_graph": { "type": "object" },
    "risk_register": { "type": "array", "items": { "type": "object" } },
    "simulation_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_effects_by_pattern",
        "critical_resources_by_pattern",
        "storage_by_pattern",
        "provisional"
      ],
      "properties": {
        "resource_effects_by_pattern": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["water_liters_per_day", "energy_kwh_per_day", "food_servings_per_day"],
            "properties": {
              "water_liters_per_day": { "type": "number" },
              "energy_kwh_per_day": { "type": "number" },
              "food_servings_per_day": { "type": "number" }
            }
          }
        },
        "critical_resources_by_pattern": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "storage_by_pattern": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "object" }
          }
        },
        "capability_effects_by_pattern": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "capability_metadata_by_pattern": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "seasonal_profile": { "type": "object" },
        "household_profile": { "type": "object" },
        "population_context": { "type": "object" },
        "provisional": { "type": "boolean" }
      }
    },
    "promotion_status": { "type": "string" }
  }
}
