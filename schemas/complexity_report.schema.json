{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/complexity_report.schema.json",
  "title": "ComplexityReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "generated_by",
    "provisional",
    "status",
    "module_registry",
    "registry_summary",
    "pattern_summary",
    "bundle_results",
    "slot_results",
    "pattern_results",
    "hotspots",
    "recommendations",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "ComplexityReport" },
    "id": { "type": "string" },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["manageable", "needs_simplification", "blocked"] },
    "module_registry": { "type": "string" },
    "registry_summary": { "type": "object" },
    "pattern_summary": { "type": "object" },
    "bundle_results": { "type": "array", "items": { "type": "object" } },
    "slot_results": { "type": "array", "items": { "type": "object" } },
    "pattern_results": { "type": "array", "items": { "type": "object" } },
    "hotspots": { "type": "array", "items": { "type": "object" } },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
