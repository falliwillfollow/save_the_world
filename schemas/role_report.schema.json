{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/role_report.schema.json",
  "title": "RoleReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "compiled_plan",
    "role_plan",
    "generated_by",
    "weeks",
    "provisional",
    "status",
    "assigned_role_schedule",
    "unfilled_roles",
    "overloaded_residents",
    "single_point_of_failure_roles",
    "backup_coverage",
    "care_work_accounting",
    "fairness",
    "burnout_warnings",
    "redesign_recommendations",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "RoleReport" },
    "id": { "type": "string" },
    "compiled_plan": { "type": "string" },
    "role_plan": { "type": "string" },
    "generated_by": { "type": "string" },
    "weeks": { "type": "integer", "minimum": 1 },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "assigned_role_schedule": { "type": "array", "items": { "type": "object" } },
    "unfilled_roles": { "type": "array", "items": { "type": "string" } },
    "overloaded_residents": { "type": "array", "items": { "type": "object" } },
    "single_point_of_failure_roles": { "type": "array", "items": { "type": "string" } },
    "backup_coverage": { "type": "object" },
    "care_work_accounting": { "type": "object" },
    "fairness": { "type": "object" },
    "burnout_warnings": { "type": "array", "items": { "type": "string" } },
    "redesign_recommendations": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
