{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/food_labor_report.schema.json",
  "title": "FoodLaborReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "generated_by",
    "provisional",
    "status",
    "module_registry",
    "slot",
    "primary_pattern",
    "related_patterns",
    "unmodeled_patterns",
    "summary",
    "category_results",
    "scaling_results",
    "hotspots",
    "recommendations",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "FoodLaborReport" },
    "id": { "type": "string" },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "module_registry": { "type": "string" },
    "slot": { "type": "string" },
    "primary_pattern": { "type": "string" },
    "modeled_patterns": { "type": "array", "items": { "type": "string" } },
    "related_patterns": { "type": "array", "items": { "type": "string" } },
    "unmodeled_patterns": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "object" },
    "category_results": { "type": "array", "items": { "type": "object" } },
    "scaling_results": { "type": "array", "items": { "type": "object" } },
    "hotspots": { "type": "array", "items": { "type": "object" } },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
