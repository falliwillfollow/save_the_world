{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/site_profile.schema.json",
  "title": "SiteProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "acres",
    "site_type",
    "climate_zone",
    "households",
    "population_target",
    "legal_compliance_assumption",
    "water_sources",
    "build_phasing",
    "priorities",
    "selected_patterns",
    "resolved_external_dependencies"
  ],
  "properties": {
    "kind": { "const": "SiteProfile" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "acres": { "type": "number", "exclusiveMinimum": 0 },
    "site_type": { "type": "string", "enum": ["rural", "peri_urban", "urban_infill"] },
    "climate_zone": { "type": "string", "minLength": 3 },
    "seasonal_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "household_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "spatial_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "households": { "type": "integer", "minimum": 1 },
    "population_target": { "type": "integer", "minimum": 1 },
    "legal_compliance_assumption": { "type": "string", "minLength": 10 },
    "water_sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "build_phasing": { "type": "string", "minLength": 3 },
    "priorities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "selected_patterns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "resolved_external_dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
