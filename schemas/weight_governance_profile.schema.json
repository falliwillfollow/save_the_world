{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/weight_governance_profile.schema.json",
  "title": "WeightGovernanceProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "provisional",
    "optimization_profile",
    "authority",
    "objective_weights",
    "approval_gates",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "WeightGovernanceProfile" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "provisional": { "type": "boolean" },
    "optimization_profile": { "type": "string" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weight_authority",
        "resident_consent_status",
        "professional_review_status",
        "last_reviewed",
        "next_review_due",
        "provisional"
      ],
      "properties": {
        "weight_authority": { "type": "string" },
        "resident_consent_status": {
          "type": "string",
          "enum": ["not_started", "draft", "reviewing", "ratified", "rejected"]
        },
        "professional_review_status": {
          "type": "string",
          "enum": ["not_started", "draft", "reviewing", "accepted", "rejected"]
        },
        "last_reviewed": { "type": "string" },
        "next_review_due": { "type": "string" },
        "provisional": { "type": "boolean" }
      }
    },
    "objective_weights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objective", "weight", "status", "rationale", "provisional"],
        "properties": {
          "objective": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "weight": { "type": "number", "minimum": 0 },
          "status": {
            "type": "string",
            "enum": ["draft", "reviewing", "ratified", "rejected"]
          },
          "rationale": { "type": "string", "minLength": 5 },
          "provisional": { "type": "boolean" }
        }
      }
    },
    "approval_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required_status", "description", "provisional"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "required_status": { "type": "string" },
          "description": { "type": "string", "minLength": 5 },
          "provisional": { "type": "boolean" }
        }
      }
    },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
