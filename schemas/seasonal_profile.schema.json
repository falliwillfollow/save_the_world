{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/seasonal_profile.schema.json",
  "title": "SeasonalProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "climate_zone", "generated_by", "provisional", "seasons", "unknowns"],
  "properties": {
    "kind": { "const": "SeasonalProfile" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "climate_zone": { "type": "string", "minLength": 3 },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "seasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start_day", "end_day", "resource_multipliers", "maintenance_labor_multiplier", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "start_day": { "type": "integer", "minimum": 1, "maximum": 365 },
          "end_day": { "type": "integer", "minimum": 1, "maximum": 365 },
          "resource_multipliers": {
            "type": "object",
            "additionalProperties": false,
            "required": ["water_liters", "energy_kwh", "food_servings"],
            "properties": {
              "water_liters": { "$ref": "#/definitions/flowMultipliers" },
              "energy_kwh": { "$ref": "#/definitions/flowMultipliers" },
              "food_servings": { "$ref": "#/definitions/flowMultipliers" }
            }
          },
          "maintenance_labor_multiplier": { "type": "number", "exclusiveMinimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "flowMultipliers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "consumption"],
      "properties": {
        "production": { "type": "number", "minimum": 0 },
        "consumption": { "type": "number", "minimum": 0 }
      }
    }
  }
}
