      "typeVersion": 4.2,
      "position": [
        760,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.response || '{}';\nlet brief;\ntry {\n  brief = JSON.parse(raw);\n} catch (error) {\n  brief = {\n    parse_error: error.message,\n    raw_response: raw\n  };\n}\nreturn [{ json: { ok: true, model: $json.model, discovery_brief: brief } }];"
      },
      "id": "2f2a2c17-9ee5-4d15-9724-41c8fbb93a43",
