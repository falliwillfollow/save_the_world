{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/search_optimizer_report.schema.json",
  "title": "SearchOptimizerReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "compiled_plan",
    "optimization_profile",
    "generated_by",
    "provisional",
    "status",
    "search_space",
    "candidate_count",
    "viable_candidate_count",
    "rejected_candidate_count",
    "selected_candidate",
    "top_candidates",
    "binding_constraints",
    "locked_assumptions",
    "sensitivity_checks",
    "constraint_explanations",
    "metric_updates",
    "next_actions",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "SearchOptimizerReport" },
    "id": { "type": "string" },
    "compiled_plan": { "type": "string" },
    "optimization_profile": { "type": "string" },
    "generated_by": { "type": "string" },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["not_ready", "ready_with_warnings", "ready"] },
    "search_space": { "type": "object" },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "viable_candidate_count": { "type": "integer", "minimum": 0 },
    "rejected_candidate_count": { "type": "integer", "minimum": 0 },
    "selected_candidate": { "type": "string" },
    "top_candidates": { "type": "array", "items": { "type": "object" } },
    "binding_constraints": { "type": "array", "items": { "type": "object" } },
    "locked_assumptions": { "type": "array", "items": { "type": "object" } },
    "sensitivity_checks": { "type": "array", "items": { "type": "object" } },
    "constraint_explanations": { "type": "array", "items": { "type": "object" } },
    "metric_updates": { "type": "object" },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
