{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/discovery_candidate_intervention.schema.json",
  "title": "DiscoveryCandidateIntervention",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "id",
    "source_loop_id",
    "focus_domain",
    "title",
    "hypothesis",
    "intervention_type",
    "target_objects",
    "module_refs",
    "assumptions",
    "expected_effects",
    "risk_tradeoffs",
    "simulation_hooks",
    "rag_context",
    "status",
    "provisional"
  ],
  "properties": {
    "kind": { "const": "DiscoveryCandidateIntervention" },
    "version": { "const": "v0" },
    "id": { "type": "string", "minLength": 3 },
    "source_loop_id": { "type": "string", "minLength": 3 },
    "focus_domain": { "type": "string", "minLength": 2 },
    "title": { "type": "string", "minLength": 3 },
    "hypothesis": { "type": "string", "minLength": 10 },
    "intervention_type": {
      "type": "string",
      "enum": ["pattern_patch", "module_candidate", "operating_protocol", "scenario_playbook", "governance_rule", "research_task"]
    },
    "target_objects": { "type": "array", "items": { "type": "string" } },
    "module_refs": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/assumption" } },
    "expected_effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/effect" } },
    "risk_tradeoffs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/risk_tradeoff" } },
    "simulation_hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics_to_compare", "scenarios_to_run", "acceptance_tests"],
      "properties": {
        "metrics_to_compare": { "type": "array", "items": { "type": "string" } },
        "scenarios_to_run": { "type": "array", "items": { "type": "string" } },
        "acceptance_tests": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rag_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries", "required_sources", "source_ids"],
      "properties": {
        "queries": { "type": "array", "items": { "type": "string" } },
        "required_sources": { "type": "array", "items": { "type": "string" } },
        "source_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "generated", "simulation_ready", "simulation_tested", "rejected", "promoted"]
    },
    "provisional": { "type": "boolean" }
  },
  "definitions": {
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "confidence", "needs_evidence"],
      "properties": {
        "id": { "type": "string" },
        "statement": { "type": "string" },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "needs_evidence": { "type": "boolean" }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction", "rationale"],
      "properties": {
        "metric": { "type": "string" },
        "direction": { "type": "string", "enum": ["increase", "decrease", "neutral", "unknown"] },
        "rationale": { "type": "string" }
      }
    },
    "risk_tradeoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "severity", "mitigation"],
      "properties": {
        "risk": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
        "mitigation": { "type": "string" }
      }
    }
  }
}
