{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/food_plan.schema.json",
  "title": "FoodPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "name",
    "description",
    "population",
    "days",
    "provisional",
    "targets",
    "foods",
    "fallback_procurement",
    "notes"
  ],
  "properties": {
    "kind": { "const": "FoodPlan" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 10 },
    "population": { "type": "integer", "minimum": 1 },
    "days": { "type": "integer", "minimum": 1 },
    "provisional": { "type": "boolean" },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calories_per_person_per_day", "protein_grams_per_person_per_day", "storage_days_target", "local_food_percent_target"],
      "properties": {
        "calories_per_person_per_day": { "type": "number", "minimum": 1 },
        "protein_grams_per_person_per_day": { "type": "number", "minimum": 1 },
        "storage_days_target": { "type": "number", "minimum": 0 },
        "local_food_percent_target": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "foods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source",
          "calories_per_day",
          "protein_grams_per_day",
          "servings_per_day",
          "season",
          "storage_life_days",
          "stored_days",
          "preservation_method",
          "water_sensitivity",
          "external_dependency",
          "provisional"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 2 },
          "source": { "type": "string", "enum": ["local", "stored", "external"] },
          "calories_per_day": { "type": "number", "minimum": 0 },
          "protein_grams_per_day": { "type": "number", "minimum": 0 },
          "servings_per_day": { "type": "number", "minimum": 0 },
          "season": { "type": "string", "minLength": 3 },
          "storage_life_days": { "type": "number", "minimum": 0 },
          "stored_days": { "type": "number", "minimum": 0 },
          "preservation_method": { "type": "string", "minLength": 3 },
          "water_sensitivity": { "type": "string", "enum": ["low", "medium", "high"] },
          "external_dependency": { "type": "string" },
          "provisional": { "type": "boolean" }
        }
      }
    },
    "fallback_procurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "calories_per_day", "protein_grams_per_day", "lead_time_days", "notes"],
      "properties": {
        "available": { "type": "boolean" },
        "calories_per_day": { "type": "number", "minimum": 0 },
        "protein_grams_per_day": { "type": "number", "minimum": 0 },
        "lead_time_days": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "notes": { "type": "string", "minLength": 5 }
  }
}
