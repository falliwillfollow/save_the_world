{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/nutrition_report.schema.json",
  "title": "NutritionReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "compiled_plan",
    "food_plan",
    "generated_by",
    "days",
    "population",
    "provisional",
    "status",
    "nutrition",
    "local_food",
    "storage",
    "shortage_timeline",
    "fallback_procurement_needs",
    "dietary_risk_warnings",
    "bottlenecks",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "NutritionReport" },
    "id": { "type": "string" },
    "compiled_plan": { "type": "string" },
    "food_plan": { "type": "string" },
    "generated_by": { "type": "string" },
    "days": { "type": "integer", "minimum": 1 },
    "population": { "type": "integer", "minimum": 1 },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "nutrition": { "type": "object" },
    "local_food": { "type": "object" },
    "storage": { "type": "object" },
    "shortage_timeline": { "type": "array", "items": { "type": "object" } },
    "fallback_procurement_needs": { "type": "array", "items": { "type": "string" } },
    "dietary_risk_warnings": { "type": "array", "items": { "type": "string" } },
    "bottlenecks": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
