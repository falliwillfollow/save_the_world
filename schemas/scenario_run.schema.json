{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciac.local/schemas/scenario_run.schema.json",
  "title": "ScenarioRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "compiled_plan",
    "scenario",
    "generated_by",
    "days",
    "provisional",
    "status",
    "baseline_status",
    "runtime_failures",
    "failure_timeline",
    "affected_resources",
    "resource_balance",
    "emergency_labor",
    "review_context",
    "triggered_risks",
    "bottlenecks",
    "survival_critical_gate_failures",
    "recommended_redesigns",
    "unknowns"
  ],
  "properties": {
    "kind": { "const": "ScenarioRun" },
    "id": { "type": "string" },
    "compiled_plan": { "type": "string" },
    "scenario": { "type": "string" },
    "generated_by": { "type": "string" },
    "days": { "type": "integer", "minimum": 1 },
    "provisional": { "type": "boolean" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "baseline_status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "runtime_failures": { "type": "array", "items": { "type": "object" } },
    "failure_timeline": { "type": "array", "items": { "type": "object" } },
    "affected_resources": { "type": "array", "items": { "type": "string" } },
    "resource_balance": { "type": "object" },
    "emergency_labor": { "type": "object" },
    "review_context": { "type": "object" },
    "triggered_risks": { "type": "array", "items": { "type": "object" } },
    "bottlenecks": { "type": "array", "items": { "type": "string" } },
    "survival_critical_gate_failures": { "type": "array", "items": { "type": "string" } },
    "recommended_redesigns": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
